<?xml version="1.0" encoding="utf-8"?>
<!-- Full art on a matching blue background so every launcher mask (circle,
     squircle, teardrop) shows the shield/chickens intact. The inset keeps the
     art inside the adaptive-icon safe zone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launch_bg" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_art"
            android:inset="16%" />
    </foreground>
</adaptive-icon>
