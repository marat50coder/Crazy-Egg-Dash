<?xml version="1.0" encoding="utf-8"?>
<!-- Identical adaptive-icon to the launcher icon so the Android 12+ splash
     logo matches the home-screen icon exactly. Android 12+ only accepts an
     AdaptiveIconDrawable here; a flat PNG would silently fall back. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launch_bg" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_art"
            android:inset="16%" />
    </foreground>
</adaptive-icon>
